# URL koneksi PostgreSQL (sesuai docker-compose.yml)
DATABASE_URL="postgresql://siakad:siakad@localhost:5432/siakad?schema=public"

# Kunci rahasia untuk menandatangani sesi (buat dengan: npx auth secret)
AUTH_SECRET="ganti-dengan-rahasia-acak"

# URL dasar aplikasi untuk Auth.js
AUTH_URL=http://localhost:3000

# Endpoint LLM yang kompatibel dengan OpenAI (untuk modul asisten)
LLM_BASE_URL=

# API key untuk endpoint LLM
LLM_API_KEY=

# Nama model LLM yang dipakai
LLM_MODEL=

# Endpoint server embedding (Ollama lokal)
EMBED_BASE_URL=http://localhost:11434

# Nama model embedding
EMBED_MODEL=bge-m3
